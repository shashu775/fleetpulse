# FleetPulse configuration contract.
#
#   cp .env.example .env      then edit
#
# .env is gitignored; this file is committed. RULE: when code needs a new
# variable, add it here with a safe placeholder in the SAME change.
#
# docker-compose.yml has defaults for everything below, so the stack starts
# even without a .env file. Create one to override.

# ---- PostgreSQL ----------------------------------------------------------
# Local dev only. On AWS these come from RDS and the password lives in
# Secrets Manager, never in a file.
POSTGRES_USER=fleetadmin
POSTGRES_PASSWORD=localdevpassword
POSTGRES_DB=fleetpulse

# Full connection string. Compose builds this from the three values above;
# set it directly when pointing at RDS:
#   postgresql://fleetadmin:PASSWORD@fleetpulse-db.xxxx.rds.amazonaws.com:5432/fleetpulse
# DATABASE_URL=

# ---- Redis ---------------------------------------------------------------
# Two different jobs: a tracking CACHE for consignment-service (fails soft),
# and the last-known-position STORE for dispatch-service (no fallback).
REDIS_URL=redis://redis:6379/0

# ---- Service discovery ---------------------------------------------------
# How dispatch-service reaches consignment-service. Resolved by Docker
# Compose DNS locally, and by Kubernetes DNS unchanged on a cluster.
CONSIGNMENT_URL=http://consignment-service:8000

# ---- Logging -------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- AWS (unused until Milestone 3) --------------------------------------
AWS_REGION=us-east-1
